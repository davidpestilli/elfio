{
  "start": "start",
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "label": "Start",
      "ui": {
        "x": -290,
        "y": -180
      }
    },
    {
      "id": "rf_login",
      "kind": "action",
      "label": "1. Login eproc (perfil advogado)",
      "action": {
        "type": "run_flow",
        "project": "login",
        "outputs": [
          "ScreenText",
          "EprocUrl",
          "EprocUser"
        ]
      },
      "ui": {
        "x": -320,
        "y": 0
      }
    },
    {
      "id": "sw_tela",
      "kind": "switch",
      "label": "Chegou na tela de entrega?",
      "control": {
        "type": "switch",
        "expression": "{ScreenText}",
        "ignore_case": true
      },
      "ui": {
        "x": -50,
        "y": 0
      }
    },
    {
      "id": "case_painel",
      "kind": "case",
      "label": "Painel do advogado",
      "control": {
        "type": "case",
        "value": "Painel",
        "operator": "contains"
      },
      "ui": {
        "x": 200,
        "y": 0
      }
    },
    {
      "id": "def_tela",
      "kind": "case_default",
      "label": "Outra tela",
      "control": {
        "type": "case_default"
      },
      "ui": {
        "x": 200,
        "y": 230
      }
    },
    {
      "id": "rf_peticao",
      "kind": "action",
      "label": "2. Peticionamento (assume a tela)",
      "action": {
        "type": "run_flow",
        "project": "peticionar",
        "inputs": {
          "ScreenText": "{ScreenText}",
          "EprocUrl": "{EprocUrl}",
          "EprocUser": "{EprocUser}"
        },
        "outputs": [
          "PetitionNumber"
        ]
      },
      "ui": {
        "x": 590,
        "y": 0
      }
    },
    {
      "id": "log_ok",
      "kind": "action",
      "label": "Log protocolo",
      "action": {
        "type": "log",
        "message": "superfluxo eproc concluido: protocolo {PetitionNumber} na tela \u0060{ScreenText}\u0060"
      },
      "ui": {
        "x": 880,
        "y": 0
      }
    },
    {
      "id": "log_abort",
      "kind": "action",
      "label": "Aviso: tela inesperada (segue)",
      "action": {
        "type": "log",
        "message": "superfluxo eproc: tela inesperada \u0060{ScreenText}\u0060; seguindo (a guarda do peticionamento decide)"
      },
      "ui": {
        "x": 420,
        "y": 230
      }
    },
    {
      "id": "end",
      "kind": "end",
      "label": "End",
      "ui": {
        "x": 880,
        "y": 150
      }
    }
  ],
  "edges": [
    {
      "from": "rf_login",
      "to": "sw_tela",
      "port": "main"
    },
    {
      "from": "sw_tela",
      "to": "case_painel",
      "port": "then"
    },
    {
      "from": "case_painel",
      "to": "rf_peticao",
      "port": "then"
    },
    {
      "from": "def_tela",
      "to": "log_abort",
      "port": "main"
    },
    {
      "from": "rf_peticao",
      "to": "log_ok",
      "port": "main"
    },
    {
      "from": "case_painel",
      "to": "def_tela",
      "port": "else",
      "ui": {
        "targetHandle": "top"
      }
    },
    {
      "from": "log_abort",
      "to": "rf_peticao",
      "port": "main",
      "ui": {
        "sourceHandle": "top"
      }
    },
    {
      "from": "start",
      "to": "rf_login",
      "port": "main",
      "ui": {
        "sourceHandle": "bottom",
        "targetHandle": "top"
      }
    },
    {
      "from": "log_ok",
      "to": "end",
      "port": "main",
      "ui": {
        "sourceHandle": "bottom",
        "targetHandle": "top"
      }
    }
  ],
  "variables": {
    "EprocUrl": "",
    "EprocUser": "",
    "PetitionNumber": "",
    "ScreenText": ""
  }
}