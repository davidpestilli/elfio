    },
    {
      "id": "if_run_mode",
      "kind": "if",
      "label": "Rodando sozinho (individual)?",
      "control": {
        "type": "if",
        "left": "{HoblioRunMode}",
        "operator": "eq",
        "right": "standalone",
        "ignore_case": true
      },
      "ui": {
        "x": -720,
        "y": -470
      }
    },
    {
      "id": "attach_browser",
      "kind": "action",
      "label": "Individual: anexa ao navegador aberto (CDP 9222)",
      "action": {
        "type": "browser_attach_chrome",
        "url": "eproc",
        "attach_mode": "by_url",
        "debugging_port": 9222
      },
      "ui": {
        "x": -430,
        "y": -470
      }
    },
    {
      "id": "msg_manual",
      "kind": "action",
      "label": "Individual: confirma a tela com o usuario",
      "action": {
        "type": "show_message",
        "title": "Peticionamento eproc \u2014 modo individual",
        "text": "Execu\u00E7\u00E3o individual do fluxo eproc-peticionamento (sem superfluxo).\n\nAnexei ao navegador j\u00E1 aberto na porta 9222 (CDP).\n\nDeixe a aba do eproc no Painel do Advogado, j\u00E1 logado, e clique em OK.\nO fluxo espera o menu do painel por 120s: se a tela n\u00E3o for o painel, ele para no passo seguinte."
      },
      "ui": {
        "x": -40,
        "y": -470
      }
    },
    {
      "id": "wait_menu_manual",
      "kind": "action",
      "label": "Individual: espera o painel do advogado",
      "action": {
        "type": "browser_wait_for",
        "selector": "#main-menu a[href*=\u0022acao=processo_cadastrar\u0022]",
        "timeout_ms": 120000,
        "wait_visible": true
      },
      "ui": {
        "x": 270,
        "y": -470
      }
    },
    {
      "id": "read_screen_manual",
      "kind": "action",
      "label": "Individual: ScreenText = h1 do painel (prova de tela)",
      "action": {
        "type": "browser_get_text",
        "selector": "#divInfraBarraLocalizacao \u003E div \u003E h1",
        "timeout_ms": 5000,
        "variable": "ScreenText"
      },
      "ui": {
        "x": 630,
        "y": -470
      },
      "error_handling": {
        "retry_count": 1,
        "retry_delay_ms": 500,
        "on_failure": "continue"
      }
    },
    {
      "id": "rf_abrir",
      "kind": "action",
      "label": "1. Abre o peticionamento (painel -\u003E etapa 1)",
      "action": {
        "type": "run_flow",
        "flow_id": "abrir_peticionamento",
        "share_browser": true,
        "variable_scope": "inherit"
      },
      "ui": {
        "x": -580,
        "y": -70
      }
    },
    {
