<Window x:Class="Hoblio.Runtime.SelectFromListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock x:Name="MessageBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <ComboBox x:Name="SingleChoiceCombo" MinWidth="320" MinHeight="28" Margin="0,0,0,4"
              Visibility="Collapsed"/>
    <ListBox x:Name="MultiChoiceList" MinWidth="320" MinHeight="140" Margin="0,0,0,4"
             Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkClick"/>
      <Button Content="Cancelar" Width="80" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
