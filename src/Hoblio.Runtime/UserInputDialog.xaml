<Window x:Class="Hoblio.Runtime.UserInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBox x:Name="InputBox" MinWidth="320" AcceptsReturn="{Binding Multiline}" MinHeight="{Binding InputHeight}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkClick"/>
      <Button Content="Cancelar" Width="80" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
