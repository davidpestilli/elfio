<UserControl x:Class="Hoblio.Studio.ActionPalettePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.PanelBg}">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
      <TextBlock Text="Ações" FontSize="15" FontWeight="SemiBold" Foreground="#111827"/>
      <TextBlock Text="Clique para adicionar ao fluxo. Ligue nós arrastando conectores no canvas."
                 TextWrapping="Wrap" FontSize="11" Foreground="#6B7280" Margin="0,4,0,8"/>
      <TextBlock Text="Filtrar" Style="{StaticResource FieldLabel}" Margin="0"/>
      <TextBox Text="{Binding PaletteFilter, UpdateSourceTrigger=PropertyChanged}"
               Style="{StaticResource FieldBox}" Margin="0"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
      <ItemsControl ItemsSource="{Binding FilteredPaletteGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource PaletteGroupHeader}"/>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource PaletteActionButton}"
                            Command="{Binding DataContext.AddPaletteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Key}"
                            ToolTip="{Binding Hint}"
                            Content="{Binding Title}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
