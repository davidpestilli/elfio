<UserControl x:Class="Hoblio.Studio.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hoblio.Studio"
             Background="{StaticResource Brush.PanelBg}">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Padding="12,10">
      <StackPanel>
        <TextBlock Text="Propriedades" FontSize="15" FontWeight="SemiBold" Foreground="#111827"/>
        <TextBlock Text="{Binding PropertiesPanelSubtitle, Mode=OneWay}" Style="{StaticResource PropertiesPanelSubtitle}"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
      <StackPanel>
        <!-- Canvas focus (Rust: no node selected) -->
        <StackPanel Visibility="{Binding ShowCanvasProperties, Converter={StaticResource BoolVis}}">
          <Expander IsExpanded="False" Style="{StaticResource PropsSection}"
                    Visibility="{Binding ShowActiveSubflowManage, Converter={StaticResource BoolVis}}">
            <Expander.Header>
              <TextBlock Text="Subfluxo atual" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel>
              <TextBlock Text="{Binding ActiveSubflowDefinedHint, Mode=OneWay}" Style="{StaticResource PropertiesSectionHint}"/>
              <TextBlock Text="Identificador" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding ActiveSubflowRenameDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Renomear" Style="{StaticResource SecondaryToolButton}"
                        Command="{Binding ApplyActiveSubflowRenameCommand}"/>
                <Button Content="Excluir" Style="{StaticResource DangerPanelButton}" Padding="8,4" Margin="0"
                        Command="{Binding DeleteActiveSubflowCommand}"/>
              </StackPanel>
              <TextBlock Text="{Binding ActiveSubflowRenameError}" Foreground="#DC2626" FontSize="11"/>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="False" Style="{StaticResource PropsSection}"
                    Visibility="{Binding ShowEmbeddedSubflowsList, Converter={StaticResource BoolVis}}">
            <Expander.Header>
              <TextBlock FontWeight="SemiBold">
                <Run Text="Subfluxos embutidos"/>
                <Run Text="{Binding EmbeddedSubflowCount, Mode=OneWay, StringFormat=' ({0})'}"/>
              </TextBlock>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding EmbeddedSubflowRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource PropertiesListRow}">
                    <StackPanel>
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Content="Abrir" Style="{StaticResource PropertiesHyperlinkButton}"
                                  Command="{Binding OpenCommand}" CommandParameter="{Binding Id}"/>
                          <Button Content="⋯" Style="{StaticResource SecondaryToolButton}" Padding="8,2" Margin="4,0,0,0"
                                  ToolTip="Mais ações">
                            <Button.ContextMenu>
                              <ContextMenu
                                  DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Renomear…" Command="{Binding BeginRenameCommand}"/>
                                <Separator/>
                                <MenuItem Header="Excluir" Command="{Binding DeleteCommand}"/>
                              </ContextMenu>
                            </Button.ContextMenu>
                          </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                      </DockPanel>
                      <StackPanel Margin="0,8,0,0"
                                  Visibility="{Binding ShowRenameEditor, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Novo identificador" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Aplicar" Style="{StaticResource SecondaryToolButton}" Command="{Binding ApplyRenameCommand}"/>
                          <Button Content="Cancelar" Style="{StaticResource SecondaryToolButton}" Command="{Binding CancelRenameCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RenameError}" Foreground="#DC2626" FontSize="11" Margin="0,4,0,0"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Expander IsExpanded="False" Style="{StaticResource PropsSection}">
            <Expander.Header>
              <TextBlock Text="{Binding VariablesSectionTitle}" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel>
              <TextBlock Text="{Binding VariablesSectionHint}" Style="{StaticResource PropertiesSectionHint}"/>
              <local:ProjectVariablesPanel DataContext="{Binding}"/>
            </StackPanel>
          </Expander>

          <Expander Style="{StaticResource PropsSection}" IsExpanded="False">
            <Expander.Header>
              <TextBlock FontWeight="SemiBold">
                <Run Text="Variáveis na execução"/>
                <Run Text="{Binding FlowVariableProducerCount, Mode=OneWay, StringFormat=' ({0})'}"/>
              </TextBlock>
            </Expander.Header>
            <StackPanel>
              <TextBlock Style="{StaticResource PropertiesSectionHint}"
                         Text="Nomes atribuídos durante a execução por ações e loops (somente leitura)."/>
              <StackPanel Visibility="{Binding ShowFlowVariableProducerSearch, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                <TextBlock Text="Filtrar" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding FlowVariableProducerFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}" Margin="0"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding FilteredFlowVariableProducers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource PropertiesListRow}" Padding="8,6">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <Border Style="{StaticResource PropertiesSourceBadge}">
                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#475569"/>
                          </Border>
                          <TextBlock Text="→" Foreground="#94A3B8" Margin="6,0" VerticalAlignment="Center"/>
                          <Button Content="{Binding NodeLabel}" Style="{StaticResource PropertiesHyperlinkButton}"
                                  HorizontalAlignment="Left"
                                  Command="{Binding DataContext.SelectFlowProducerNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding NodeId}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Nenhuma variável ainda — use BrowserGetText ou Definir variável."
                         Style="{StaticResource PropertiesSectionHint}" Margin="0"
                         Visibility="{Binding ShowEmptyFlowProducers, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="Nenhum resultado para o filtro."
                         Style="{StaticResource PropertiesSectionHint}" Margin="0"
                         Visibility="{Binding ShowEmptyFilteredFlowProducers, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Expander>
        </StackPanel>

        <!-- Node selected (Rust: Properties) -->
        <StackPanel Visibility="{Binding ShowNodeProperties, Converter={StaticResource BoolVis}}"
                    IsEnabled="{Binding IsEditing}">
          <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                  Visibility="{Binding ShowSubflowContextBanner, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding SubflowContextBannerText}" TextWrapping="Wrap" Foreground="#1E40AF" FontSize="11"/>
          </Border>

          <Expander IsExpanded="False" Style="{StaticResource PropsSection}">
            <Expander.Header>
              <TextBlock Text="Identidade" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel>
              <TextBlock Text="Id" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SelectedNodeId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldBox}" Foreground="#6B7280"/>
              <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SelectedNodeKindDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FieldBox}" Foreground="#6B7280"/>
              <TextBlock Text="Rótulo" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding NodeLabelEdit, UpdateSourceTrigger=PropertyChanged}"
                       IsReadOnly="{Binding IsStartNodeSelected}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="{Binding ProducerRenameError}" Foreground="#DC2626" FontSize="11" Margin="0,0,0,8"
                         Visibility="{Binding HasProducerRenameError, Converter={StaticResource BoolVis}}"/>
              <Button Content="Excluir nó" Style="{StaticResource DangerPanelButton}" Margin="0,4,0,0"
                      Command="{Binding DeleteNodeCommand}"
                      Visibility="{Binding ShowDeleteNodeButton, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="False" Style="{StaticResource PropsSection}"
                    Visibility="{Binding ShowNodeLogicSection, Converter={StaticResource BoolVis}}">
            <Expander.Header>
              <TextBlock Text="Lógica e loops" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel>
          <StackPanel Visibility="{Binding ShowIfSection, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Left" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding TemplateVariableNames}" Text="{Binding IfLeft, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <TextBlock Text="Operator" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding CompareOperators}" SelectedItem="{Binding IfOperator}" Margin="0,0,0,10"/>
            <TextBlock Text="Right" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding TemplateVariableNames}" Text="{Binding IfRight, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <local:TemplateVariableChips FieldKey="IfLeft" DataContext="{Binding}"/>
            <local:TemplateVariableChips FieldKey="IfRight" DataContext="{Binding}"/>
            <CheckBox Content="Ignore case (text operators only)" IsChecked="{Binding IfIgnoreCase}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                       Text="Connect saída then (→) e else (↓)."/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowSwitchSection, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Expressão" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding TemplateVariableNames}" Text="{Binding SwitchExpression, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <local:TemplateVariableChips FieldKey="SwitchExpression" DataContext="{Binding}"/>
            <CheckBox Content="Ignore case (comparações de texto nos cases)" IsChecked="{Binding SwitchIgnoreCase}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                       Text="Saída then (→) liga ao primeiro Case. Encadeie Case com else (↓) até o próximo Case ou Default case."/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowCaseSection, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Operator" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding CompareOperators}" SelectedItem="{Binding CaseOperator}" Margin="0,0,0,10"/>
            <TextBlock Text="Value" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding TemplateVariableNames}" Text="{Binding CaseValue, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <local:TemplateVariableChips FieldKey="CaseValue" DataContext="{Binding}"/>
            <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                       Text="Compara o valor do Switch. then (→) = ramo; else (↓) = próximo Case ou Default."/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowCaseDefaultSection, Converter={StaticResource BoolVis}}">
            <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                       Text="Executado quando nenhum Case anterior correspondeu. Entrada pela saída else do último Case; saída main (→) para as ações do ramo padrão."/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowWhileSection, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Left" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding TemplateVariableNames}" Text="{Binding WhileLeft, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <TextBlock Text="Operator" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding CompareOperators}" SelectedItem="{Binding WhileOperator}" Margin="0,0,0,10"/>
            <TextBlock Text="Right" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding TemplateVariableNames}" Text="{Binding WhileRight, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <local:TemplateVariableChips FieldKey="WhileLeft" DataContext="{Binding}"/>
            <local:TemplateVariableChips FieldKey="WhileRight" DataContext="{Binding}"/>
            <CheckBox Content="Ignore case (text operators only)" IsChecked="{Binding WhileIgnoreCase}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                       Text="Re-evaluates each time the body returns. Body (→) must connect back to While; after (↓) when the condition is false."/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowRepeatSection, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Times" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding RepeatTimes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="Index variable (0-based)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding RepeatIndexVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                       Text="Body (→) returns to Repeat; after (↓) when all iterations finish."/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowForEachSection, Converter={StaticResource BoolVis}}">
            <TextBlock Text="List variable" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding ProjectListNames}"
                      Text="{Binding ForEachListVariable, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <TextBlock Text="Item variable" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ForEachItemVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                       Text="Body (→) must return to For each; after (↓) runs when the loop finishes."/>
          </StackPanel>

          <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"
                     Visibility="{Binding ShowNextExitLoopHint, Converter={StaticResource BoolVis}}"
                     Text="Coloque dentro do corpo de For each, While ou Repeat; uma saída main."/>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="False" Style="{StaticResource PropsSection}"
                    Visibility="{Binding ShowActionSection, Converter={StaticResource BoolVis}}">
            <Expander.Header>
              <TextBlock Text="{Binding NodeActionSectionTitle, Mode=OneWay}" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel>
            <TextBlock Text="Tipo de ação" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding ActionTypeOptions}" SelectedItem="{Binding ActionType}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding CurrentActionSummary, Mode=OneWay, StringFormat=Current: {0}}"
                       Foreground="#64748B" FontSize="11" Margin="0,0,0,10"/>

            <StackPanel Visibility="{Binding ShowActionNoOp, Converter={StaticResource BoolVis}}">
              <TextBlock Text="No operation (placeholder)." Foreground="#64748B" FontSize="11"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowLogFields, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Message" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LogMessageEdit, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                       MinHeight="64" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LogMessage" DataContext="{Binding}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowActionFileWrite, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Path (relative to project folder)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding FileWritePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Content" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding FileWriteContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="FileWriteContent" DataContext="{Binding}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionFileAppend, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Path (relative to project folder)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding FileAppendPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Content" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding FileAppendContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="FileAppendContent" DataContext="{Binding}"/>
              <TextBlock Text="Appends without overwriting the existing file." Foreground="#64748B" FontSize="11"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionFileRead, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Path" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding FileReadPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Output variable" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding FileReadVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionListClear, Converter={StaticResource BoolVis}}">
              <TextBlock Text="List variable" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding ProjectListNames}"
                        Text="{Binding ListClearVariable, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="True" Margin="0,0,0,10"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionListAppend, Converter={StaticResource BoolVis}}">
              <TextBlock Text="List variable" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding ProjectListNames}"
                        Text="{Binding ListAppendVariable, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="True" Margin="0,0,0,10"/>
              <TextBlock Text="Item" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding TemplateVariableNames}" Text="{Binding ListAppendItem, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="True" Margin="0,0,0,10"/>
              <local:TemplateVariableChips FieldKey="ListAppendItem" DataContext="{Binding}"/>
              <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11"
                         Text="Creates the list at [] on first append. For each can iterate it later in the same run."/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionHttpGet, Converter={StaticResource BoolVis}}">
              <TextBlock Text="URL" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpGetUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Variable (optional, stores response body)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpGetVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionHttpRequest, Converter={StaticResource BoolVis}}">
              <TextBlock Text="URL" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="HttpRequestUrl" DataContext="{Binding}"/>
              <TextBlock Text="Método HTTP" Style="{StaticResource FieldLabel}"/>
              <ComboBox SelectedValue="{Binding HttpRequestMethod}" SelectedValuePath="Content" Margin="0,0,0,10">
                <ComboBoxItem Content="get"/>
                <ComboBoxItem Content="post"/>
                <ComboBoxItem Content="put"/>
                <ComboBoxItem Content="patch"/>
                <ComboBoxItem Content="delete"/>
                <ComboBoxItem Content="head"/>
                <ComboBoxItem Content="options"/>
              </ComboBox>
              <TextBlock Text="Accept (opcional)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestAccept, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Tipo de conteúdo / Content-Type (corpo)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestContentType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Corpo (opcional; use {var} no JSON)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="HttpRequestBody" DataContext="{Binding}"/>
              <TextBlock Text="Cabeçalhos (opcional, uma linha: Nome: valor)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestCustomHeaders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="HttpRequestCustomHeaders" DataContext="{Binding}"/>
              <TextBlock Text="Variável — corpo da resposta" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestResponseBodyVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Variável — cabeçalhos da resposta" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestResponseHeadersVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Variável — código HTTP" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding HttpRequestStatusCodeVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,8,0,0"
                         Text="Equivale a Invocar serviço Web (PAD): método, Accept, cabeçalhos, corpo JSON e saídas. Omita corpo para GET; para PATCH/POST defina Content-Type (ex.: application/json)."/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionLlmCompletion, Converter={StaticResource BoolVis}}">
              <TextBlock Text="URL do endpoint" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LlmCompletionUrl" DataContext="{Binding}"/>
              <TextBlock Text="Estilo da API" Style="{StaticResource FieldLabel}"/>
              <ComboBox SelectedValue="{Binding LlmCompletionApiStyle}" SelectedValuePath="Content" Margin="0,0,0,10">
                <ComboBoxItem Content="ollama_chat"/>
                <ComboBoxItem Content="openai_chat"/>
              </ComboBox>
              <TextBlock Text="Modelo" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LlmCompletionModel" DataContext="{Binding}"/>
              <TextBlock Text="System (opcional)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionSystem, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LlmCompletionSystem" DataContext="{Binding}"/>
              <TextBlock Text="User / instrução" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionUser, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LlmCompletionUser" DataContext="{Binding}"/>
              <TextBlock Text="Documento / contexto longo (opcional)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionDocument, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LlmCompletionDocument" DataContext="{Binding}"/>
              <TextBlock Text="JSON schema / formato (opcional)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionJsonSchema, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LlmCompletionJsonSchema" DataContext="{Binding}"/>
              <TextBlock Text="Temperatura (opcional, número)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionTemperature, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="LlmCompletionTemperature" DataContext="{Binding}"/>
              <TextBlock Text="Variável — corpo JSON da resposta" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding LlmCompletionResponseBodyVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,8,0,0"
                         Text="Chamada HTTP POST com corpo gerado: ollama_chat → /api/chat (Ollama/LM Studio); openai_chat → chat/completions. Use json_object ou JSON em Esquema para saída estruturada."/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionShowMessage, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding ShowMessageTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding ShowMessageText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="ShowMessageText" DataContext="{Binding}"/>
              <TextBlock Text="Timeout (seconds, empty = until Fechar)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding ShowMessageTimeoutText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowActionShowGetUserInput, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Dialog title" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding UserInputTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Message" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding UserInputMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="UserInputMessage" DataContext="{Binding}"/>
              <TextBlock Text="Default value" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding UserInputDefault, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Input type" Style="{StaticResource FieldLabel}"/>
              <ComboBox SelectedValue="{Binding UserInputKindMode}" SelectedValuePath="Content" Margin="0,0,0,10">
                <ComboBoxItem Content="single_line"/>
                <ComboBoxItem Content="multi_line"/>
              </ComboBox>
              <CheckBox Content="Keep dialog always on top" IsChecked="{Binding UserInputTopmost}" Margin="0,0,0,10"/>
              <TextBlock Text="UserInput variable" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding UserInputVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="ButtonPressed variable" Style="{StaticResource FieldLabel}"/>
