                <TextBox Text="{Binding VarMaxValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,4,0,0"/>
                <local:TemplateVariableChips FieldKey="VarMaxValue" DataContext="{Binding}"/>
                <TextBox Text="{Binding VarDecimalPlaces, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,4,0,0"/>
                <TextBox Text="{Binding VarCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Visibility="{Binding ShowVarSectionJson, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Variável fonte / JSON literal" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding VarSourceVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                <local:TemplateVariableChips FieldKey="VarSourceVariable" DataContext="{Binding}"/>
                <TextBox Text="{Binding VarJsonText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Style="{StaticResource FieldBox}" Margin="0,4,0,0"/>
                <local:TemplateVariableChips FieldKey="VarJsonText" DataContext="{Binding}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowActionWord, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Variável de instância Word" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordInstance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Caminho (.docx / imagem / Salvar como)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <CheckBox Content="Word visível" IsChecked="{Binding WordVisible}" Margin="0,0,0,4"/>
              <CheckBox Content="Abrir somente leitura" IsChecked="{Binding WordReadOnly}" Margin="0,0,0,6"/>
              <TextBlock Text="Documento (anexar)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordDocumentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Modo (read/write/close/image — ver WordEnums)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordMode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Páginas (leitura, ex.: 1-3,5)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordPages, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Marcador" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordBookmark, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Texto / valor" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap" Style="{StaticResource FieldBox}"/>
              <CheckBox Content="Acrescentar quebra de linha ao escrever" IsChecked="{Binding WordAppendNewLine}" Margin="0,0,0,6"/>
              <TextBlock Text="Variável de saída (leitura)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordOutputVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Localizar / substituir" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordFindText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBox Text="{Binding WordReplaceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,4,0,0"/>
              <CheckBox Content="Substituir todas as ocorrências" IsChecked="{Binding WordAllMatches}" Margin="0,4,0,4"/>
              <CheckBox Content="Curingas" IsChecked="{Binding WordMatchWildcards}" Margin="0,0,0,4"/>
              <CheckBox Content="Diferenciar maiúsculas" IsChecked="{Binding WordMatchCase}" Margin="0,0,0,4"/>
              <CheckBox Content="Palavra inteira" IsChecked="{Binding WordMatchEntireWord}" Margin="0,0,0,6"/>
              <TextBlock Text="Imagem: origem (file|clipboard)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordImageSource, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Texto para posicionar imagem" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding WordTextToFind, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowActionPdf, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Ficheiro PDF" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding PdfPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="PdfPath" DataContext="{Binding}"/>
              <TextBlock Text="Modo de extração" Style="{StaticResource FieldLabel}"/>
              <ComboBox SelectedValue="{Binding PdfMode}" SelectedValuePath="Content" Margin="0,0,0,10">
                <ComboBoxItem Content="all"/>
                <ComboBoxItem Content="page"/>
                <ComboBoxItem Content="range"/>
              </ComboBox>
              <TextBlock Text="Página (1-based, modo page)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding PdfPage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="PdfPage" DataContext="{Binding}"/>
              <TextBlock Text="Intervalo — primeira página (modo range)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding PdfStartPage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="PdfStartPage" DataContext="{Binding}"/>
              <TextBlock Text="Intervalo — última página (modo range)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding PdfEndPage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <local:TemplateVariableChips FieldKey="PdfEndPage" DataContext="{Binding}"/>
              <TextBlock Text="Palavra-passe (PDF encriptado, opcional)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding PdfPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <StackPanel Visibility="{Binding PdfShowInputPathsField, Converter={StaticResource BoolVis}}">
                <TextBlock Text="PDFs de entrada (merge, um caminho por linha)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PdfInputPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}" FontFamily="Consolas"/>
                <local:TemplateVariableChips FieldKey="PdfInputPaths" DataContext="{Binding}"/>
              </StackPanel>
              <StackPanel Visibility="{Binding PdfShowOutputPathField, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Destino (pasta imagens / ficheiro novo PDF)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PdfOutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                <local:TemplateVariableChips FieldKey="PdfOutputPath" DataContext="{Binding}"/>
              </StackPanel>
              <StackPanel Visibility="{Binding PdfShowImageFormatField, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Formato de imagem (png ou jpg)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PdfImageFormat, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                <local:TemplateVariableChips FieldKey="PdfImageFormat" DataContext="{Binding}"/>
              </StackPanel>
              <StackPanel Visibility="{Binding PdfShowRowToleranceField, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Tolerância de linha (tabelas, pontos; vazio = 4)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PdfRowTolerance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                <local:TemplateVariableChips FieldKey="PdfRowTolerance" DataContext="{Binding}"/>
              </StackPanel>
              <TextBlock Text="Variável de saída (texto ou JSON; opcional em merge/páginas)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding PdfOutputVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,8,0,0"
                         Text="PdfPig (sem Adobe). Tabelas: heurística (sem OCR). Imagens: extrai XObjects; merge/extract páginas escreve PDF novo."/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowRunFlowSection, Converter={StaticResource BoolVis}}">
              <TextBlock Text="Projeto vinculado (manifest.linked_projects)" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding RunFlowProjectIds}"
                        Text="{Binding RunFlowProject, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="True" Margin="0,0,0,4"/>
              <TextBlock Text="{Binding RunFlowProjectHint}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Vincular projeto…" Command="{Binding LinkRunFlowProjectCommand}" Margin="0,0,6,0" Padding="6,2"/>
                <Button Content="Novo vinculado…" Command="{Binding CreateLinkedProjectCommand}" Padding="6,2"/>
              </StackPanel>
              <TextBlock Text="Flow id (manifest.flows do projeto, ou subfluxo embutido)" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding RunFlowTargetIds}"
                        Text="{Binding RunFlowId, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="True" Margin="0,0,0,10"/>
              <TextBlock Text="Path (relative to project, if no flow id)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RunFlowPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Variable scope" Style="{StaticResource FieldLabel}"/>
              <ComboBox SelectedValue="{Binding RunFlowScopeMode}" SelectedValuePath="Content" Margin="0,0,0,10">
                <ComboBoxItem Content="inherit"/>
                <ComboBoxItem Content="isolated"/>
              </ComboBox>
              <CheckBox Content="Share browser session" IsChecked="{Binding RunFlowShareBrowser}" Margin="0,0,0,10"/>
              <TextBlock Text="Inputs (one per line: var=template)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RunFlowInputsText, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Style="{StaticResource FieldBox}" FontFamily="Consolas"/>
              <local:TemplateVariableChips FieldKey="RunFlowInputsText" DataContext="{Binding}"/>
              <TextBlock Text="Outputs (comma-separated variable names for logs)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RunFlowOutputsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <Button Content="Edit subflow" Margin="0,10,0,0"
                      Command="{Binding OpenSelectedRunFlowSubflowCommand}"
                      Visibility="{Binding ShowRunFlowOpenSubflow, Converter={StaticResource BoolVis}}"/>
            </StackPanel>

            </StackPanel>
          </Expander>

          <Expander Style="{StaticResource PropsSection}" IsExpanded="False"
                    Visibility="{Binding ShowLastRunValues, Converter={StaticResource BoolVis}}">
            <Expander.Header>
              <TextBlock Text="Última execução" FontWeight="SemiBold"/>
            </Expander.Header>
            <TextBox Text="{Binding LastRunVariablesText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     MinHeight="56" TextWrapping="Wrap" FontFamily="Consolas" Background="#F9FAFB"/>
          </Expander>

          <Expander Style="{StaticResource PropsSection}" IsExpanded="False"
                    Visibility="{Binding ShowOnErrorSection, Converter={StaticResource BoolVis}}">
            <Expander.Header>
              <TextBlock Text="Em caso de erro" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel>
              <TextBlock Text="Tentativas extras" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RetryCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Intervalo entre tentativas (ms)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RetryDelayText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Se ainda falhar" Style="{StaticResource FieldLabel}"/>
              <ComboBox SelectedValue="{Binding OnFailureMode}" SelectedValuePath="Content" Margin="0,0,0,4">
                <ComboBoxItem Content="stop"/>
                <ComboBoxItem Content="continue"/>
              </ComboBox>
            </StackPanel>
          </Expander>
        </StackPanel>

        <Expander IsExpanded="False" Style="{StaticResource PropsSection}"
                  Visibility="{Binding ShowConnectionProperties, Converter={StaticResource BoolVis}}"
                  IsEnabled="{Binding IsEditing}">
          <Expander.Header>
            <TextBlock Text="Ligação" FontWeight="SemiBold"/>
          </Expander.Header>
          <StackPanel>
            <TextBlock Text="Origem" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding DiagramNodeIds}" Text="{Binding SelectedEdgeSourceId, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <TextBlock Text="Destino" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding DiagramNodeIds}" Text="{Binding SelectedEdgeTargetId, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" Margin="0,0,0,10"/>
            <TextBlock Text="Porta" Style="{StaticResource FieldLabel}"/>
            <ComboBox Text="{Binding SelectedEdgePort, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,0,10">
              <ComboBoxItem Content="main"/>
              <ComboBoxItem Content="then"/>
              <ComboBoxItem Content="else"/>
              <ComboBoxItem Content="body"/>
              <ComboBoxItem Content="after"/>
            </ComboBox>
            <Button Content="Remover ligação" Command="{Binding RemoveEdgeCommand}" Style="{StaticResource DangerPanelButton}"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
