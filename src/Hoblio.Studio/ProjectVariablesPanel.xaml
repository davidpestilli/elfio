<UserControl x:Class="Hoblio.Studio.ProjectVariablesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hoblio.Studio">
  <StackPanel>
    <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,10"
               Text="Initial values for the run. Lists are used by For each."/>
    <TextBlock Text="{Binding ProjectVariablesValidationError}" Foreground="#DC2626" FontSize="11" Margin="0,0,0,8"
               Visibility="{Binding HasProjectVariablesValidationError, Converter={StaticResource BoolVis}}"/>

    <Grid Margin="0,0,0,6">
      <TextBlock Text="Variables" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Content="+ Variable" HorizontalAlignment="Right" Padding="8,4"
              Command="{Binding AddProjectScalarCommand}"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding ProjectScalars}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:ScalarVariableRow}">
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="88"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                     LostFocus="Row_LostFocus"/>
            <ComboBox Grid.Column="1" Margin="0,0,4,0" Loaded="ScalarKind_Loaded" SelectionChanged="ScalarKind_Changed">
              <ComboBoxItem Tag="{x:Static local:ScalarVariableKind.Text}" Content="Text"/>
              <ComboBoxItem Tag="{x:Static local:ScalarVariableKind.Number}" Content="Number"/>
              <ComboBoxItem Tag="{x:Static local:ScalarVariableKind.Boolean}" Content="Boolean"/>
            </ComboBox>
            <Grid Grid.Column="2">
              <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" LostFocus="Row_LostFocus">
                <TextBox.Style>
                  <Style TargetType="TextBox">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScalarVariableKind.Boolean}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScalarVariableKind.Number}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <TextBox Text="{Binding NumberValue, UpdateSourceTrigger=PropertyChanged}" LostFocus="Row_LostFocus">
                <TextBox.Style>
                  <Style TargetType="TextBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScalarVariableKind.Number}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <CheckBox IsChecked="{Binding BoolValue}" Content="true" VerticalAlignment="Center"
                        Checked="Row_LostFocus" Unchecked="Row_LostFocus">
                <CheckBox.Style>
                  <Style TargetType="CheckBox">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScalarVariableKind.Boolean}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </CheckBox.Style>
              </CheckBox>
            </Grid>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Margin="0,12,0,6">
      <TextBlock Text="Lists" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Content="+ List" HorizontalAlignment="Right" Padding="8,4"
              Command="{Binding AddProjectListCommand}"/>
    </Grid>
    <ItemsControl ItemsSource="{Binding ProjectLists}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:ListVariableRow}">
          <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <StackPanel>
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                       LostFocus="Row_LostFocus"/>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding ., UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                             LostFocus="Row_LostFocus"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Expander Header="Advanced JSON" Margin="0,8,0,0">
      <TextBox Text="{Binding VariablesAdvancedJson, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" FontFamily="Consolas"
               IsEnabled="{Binding IsEditing}"/>
    </Expander>
  </StackPanel>
</UserControl>
